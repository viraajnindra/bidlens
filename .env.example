# Demo runs without credentials. Live extraction requires both fields below.
OPENAI_API_KEY=
OPENAI_MODEL=
# Local quickstart uses SQLite. Docker Compose uses PostgreSQL.
DATABASE_URL=sqlite:///./data/runtime/bidlens.db
PDF_ENGINE=pypdf
# Use docling after installing: pip install -e '.[ocr]'
DATA_DIR=./data/runtime
# Optional shared access token for hosted instances. Keep this server-side.
BIDLENS_API_TOKEN=
# Public government hostnames accepted by URL imports.
ALLOWED_SOURCE_HOSTS=www.a2gov.org,a2gov.org,a2gov.legistar.com
